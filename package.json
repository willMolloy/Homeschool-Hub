{
  "name": "homeschool-hub",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Homeschool Hub: year timeline planner with low-friction logging",
  "workspaces": [
    "packages/*",
    "apps/*",
    "db"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:tz": "npm run test:tz -w @hh/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @hh/web",
    "dev:api": "npm run dev -w @hh/api",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/migrate.ts --reset",
    "db:seed": "tsx db/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  }
}
